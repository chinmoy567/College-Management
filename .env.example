# api
NODE_ENV=development
PORT=3000
DATABASE_URL=            # Supabase session pooler (or local Postgres)
DIRECT_URL=              # Supabase direct connection (migrations)
SHADOW_DATABASE_URL=     # empty throwaway DB for `npm run db:drift`
TEST_DATABASE_URL=       # disposable Postgres 15 for integration tests (never a real database), e.g. postgresql://postgres:postgres@localhost:5433/cms_test
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public
SUPABASE_PRIVATE_BUCKET=private
SESSION_COOKIE_NAME=cms_session
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=               # Gmail app password
SMTP_FROM=
GROQ_API_KEY=
APP_URL=http://localhost:3000
TZ_DISPLAY=Asia/Dhaka
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=     # used once; Admin must change it at first login
TOTP_ENC_KEY=            # 32 random bytes, base64
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@example.edu
LOG_EMAIL_LINKS=true     # demo only: log reset/verify links when SMTP is blocked

# web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
