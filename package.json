{
  "name": "college-management",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @cms/shared",
    "predev": "node scripts/free-port.mjs 3000",
    "dev": "npm run build:shared && npm run dev -w @cms/api",
    "build": "npm run build:shared && npm run build -w @cms/web && npm run build -w @cms/api",
    "start": "node apps/api/dist/server.js",
    "typecheck": "npm run build:shared && npm run typecheck -w @cms/shared -w @cms/api -w @cms/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spec:check": "tsx scripts/spec-check.ts",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "tsx scripts/db-drift-check.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:seed:routine": "tsx prisma/seed-routine.ts",
    "db:seed:attendance": "tsx prisma/seed-attendance-history.ts",
    "db:seed:exams": "tsx prisma/seed-exams.ts",
    "db:seed:people": "tsx prisma/seed-people-extra.ts",
    "db:seed:community": "tsx prisma/seed-community.ts",
    "db:seed:notices": "tsx prisma/seed-notices.ts",
    "db:seed:chat": "tsx prisma/seed-chat.ts",
    "db:seed:learning": "tsx prisma/seed-learning.ts",
    "load:seed": "tsx load/seed.ts",
    "load:exam": "tsx load/exam.ts",
    "load:chat": "tsx load/chat.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2"
  }
}
